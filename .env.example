# SMTP Relay Configuration (server-owned only; all required for dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Exact comma-separated mailbox allowlist; no domains or wildcards
SMTP_ALLOWED_RECIPIENTS=
# Recipient for new directory correction requests
DIRECTORY_STEWARD_EMAIL=

# Public Firebase browser SDK key, NOT a Directory API token or SMTP secret
# Google provider and authorized browser domains must be approved separately
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0801664258
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0801664258.firebaseapp.com
# Exact origins approved by the deployment owner, also authorized in Firebase
VITE_AUTH_ALLOWED_ORIGINS=

# Store Directory API (server environment or Secret Manager references only)
GOOGLE_CLOUD_PROJECT=gen-lang-client-0801664258
FIRESTORE_DATABASE_ID=ai-studio-shiekhlocationco-00e1a479-af25-4ab6-9565-5c8b804c56a4
DIRECTORY_API_TOKEN_HMAC_SECRET=
DIRECTORY_API_CREDENTIALS_JSON=[]
DIRECTORY_API_RATE_LIMIT=100
DIRECTORY_API_RATE_WINDOW_MS=60000
PORT=3000
