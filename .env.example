# =============================================================================
# Shiekh Location & Company Directory - Environment Configuration
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# =============================================================================
# Google Cloud Firestore & Firebase Authentication (DISPATCH-007 & DISPATCH-008)
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=

# =============================================================================
# Secure Server-Side SMTP Relay Configuration (DISPATCH-013)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=directory-notifications@shiekhshoes.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Shiekh Directory Services
SMTP_FROM_EMAIL=directory-notifications@shiekhshoes.com
SMTP_REPLY_TO=directory-steward@shiekhshoes.com
DIRECTORY_STEWARD_EMAIL=m.vargas@shiekhshoes.com

# =============================================================================
# Google Business Profile (GBP) API & Service Account (DISPATCH-006 & Sec 14)
# =============================================================================
GBP_ACCOUNT_ID=accounts/5840371318
GBP_SERVICE_ACCOUNT_EMAIL=shiekh-gbp-sync-service@gen-lang-client-0801664258.iam.gserviceaccount.com
GBP_SERVICE_ACCOUNT_KEY=
GBP_PRIVATE_KEY=


