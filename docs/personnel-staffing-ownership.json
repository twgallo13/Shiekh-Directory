{
  "contractVersion": "personnel-staffing-v2.1",
  "authorities": {
    "people": ["id", "fullName", "status", "activeStatus", "primaryLocationId", "supportedLocationIds"],
    "locations": ["id", "storeNumber", "recordStatus", "regionId", "districtId", "storeManagerId", "districtManagerId", "regionalManagerId", "assistantStoreManagerIds", "keyHolderIds"],
    "regions": ["id", "name", "status"],
    "districts": ["id", "name", "status", "regionId"]
  },
  "sources": {
    "canonicalTypes": "src/types.ts",
    "scopes": "src/lib/apiScopes.ts",
    "lifecycle": "src/lib/personLifecycle.ts",
    "sourceAllowlist": "server/firestorePersonnel.ts",
    "projection": "server/personnelProjection.ts",
    "router": "server/personnelApi.ts",
    "clientAuthority": "server/firestoreApiClients.ts",
    "uiBootstrap": "src/lib/canonicalDirectoryBootstrap.ts"
  },
  "excluded": ["personnel contacts", "accounts", "login linkage", "customMetadata", "copied-name values", "name-derived IDs", "legacy reverse assignments", "requests", "audits", "mail"],
  "derivedReadOnly": ["staffing.storeManager", "staffing.districtManager", "staffing.regionalManager", "staffing.assistantStoreManagers", "staffing.keyHolders", "hierarchy"],
  "locationLifecycle": ["Active", "Retired", "Draft"],
  "identityJoins": "canonical document ID only; storeNumber is not assumed unique",
  "forbiddenNewAuthorities": ["assignment collection", "Region-owned staffing", "District-owned staffing"],
  "sync": "Pinned full snapshot across persisted collections. No Location timestamp delta feed."
}
