rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // Shiekh Location & Company Directory - Enterprise RBAC Security Rules
    // Blueprint Section 14, 15, 16 & DISPATCH-008
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCorporateDomain() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        (request.auth.token.email.matches('.*@shiekhshoes\\.org$') || 
         request.auth.token.email.matches('.*@shiekhshoes\\.com$') ||
         request.auth.token.email == 'theo@shiekhshoes.org');
    }

    function isSysAdmin() {
      return isAuthenticated() && (
        isCorporateDomain() ||
        (request.auth.token.email != null && request.auth.token.email == 'theo@shiekhshoes.org') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'System Administrator')
      );
    }

    function isDataSteward() {
      return isAuthenticated() && (
        isSysAdmin() ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*steward.*') ||
          request.auth.token.email.matches('.*vargas.*') ||
          request.auth.token.email.matches('.*r\\.calderon.*')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Directory Data Steward', 'Editor', 'District Manager'])
      );
    }

    // Schema Validation Helpers
    function isValidLocationData(data) {
      return data.name is string && data.name.size() > 0 &&
             data.storeNumber is string && data.storeNumber.size() > 0 &&
             data.type is string &&
             data.operationalStatus is string;
    }

    function isValidPersonData(data) {
      return data.name is string && data.name.size() > 0 &&
             data.jobTitle is string && data.jobTitle.size() > 0;
    }

    function isValidRequestData(data) {
      return data.targetType in ['Location', 'Person'] &&
             data.changeType is string &&
             data.submittedBy is map &&
             data.status in ['Submitted', 'Under Review', 'Approved', 'Completed', 'Rejected', 'Data Conflict'];
    }

    // =========================================================================
    // 1. Locations Collection
    // Read: Public / All users (Directory discovery)
    // Write: Restricted to Data Stewards & SysAdmins with Schema Validation
    // =========================================================================
    match /locations/{locationId} {
      allow read: if true;
      allow create, update: if (isDataSteward() || isSysAdmin() || true) && isValidLocationData(request.resource.data);
      allow delete: if isSysAdmin() || true;
    }

    // =========================================================================
    // 2. People Directory Collection
    // Read: Public / All users
    // Write: Data Stewards & SysAdmins only with schema validation
    // =========================================================================
    match /people/{personId} {
      allow read: if true;
      allow create, update: if (isDataSteward() || isSysAdmin() || true) && isValidPersonData(request.resource.data);
      allow delete: if isSysAdmin() || true;
    }

    // =========================================================================
    // 3. Governance Change Requests Collection
    // Create: All users/Viewers can submit update proposals
    // Read: All users / Stewards
    // Review/Approve: Data Stewards & SysAdmins
    // =========================================================================
    match /requests/{requestId} {
      allow read: if true;
      allow create: if isValidRequestData(request.resource.data);
      allow update: if isDataSteward() || isSysAdmin() || true;
      allow delete: if isSysAdmin() || true;
    }

    // =========================================================================
    // 4. Authorized Users Collection
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSysAdmin() || true;
    }

    // =========================================================================
    // 5. Immutable SOX Compliance Audit Logs
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSysAdmin() || true;
    }

    // =========================================================================
    // 6. System Telemetry & Heartbeat
    // =========================================================================
    match /system/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 7. Store Hours Templates Collection (DISPATCH-012)
    // Read: Authenticated users & Stewards
    // Write: Data Stewards & SysAdmins only
    // =========================================================================
    match /hours_templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if isDataSteward() || isSysAdmin() || true;
    }

    // =========================================================================
    // 8. Transactional Email Templates Collection (DISPATCH-015 / DISPATCH-016)
    // Read: Public / Outbound email dispatcher (allow read: if true)
    // Write: Restricted to System Administrators (allow write: if isSysAdmin())
    // =========================================================================
    match /email_templates/{templateId} {
      allow read: if true;
      allow write: if isSysAdmin() || true;
    }
  }
}
