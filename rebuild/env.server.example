# Server-Side Environment Variables
# These are used by Cloud Functions and the local dev server.
# For Cloud Functions, set these in Firebase: firebase functions:config:set or runtime env vars

# Allowed email domains for Google Sign-In (comma-separated)
# Only users with emails from these domains can sign in with Google
# Default: shiekhshoes.org
ALLOWED_DOMAINS=shiekhshoes.org

# Admin emails for auto-provisioning (comma-separated)
# Users with these emails will be automatically granted Admin role on first sign-in
# Example: theo@shiekhshoes.org,admin@shiekhshoes.org
ADMIN_EMAILS=theo@shiekhshoes.org

# Firebase service account (for local dev against real project)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
