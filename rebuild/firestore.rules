rules_version = '2';

// All access is via the server Admin SDK.
// Client reads and writes are denied on the default database.
// Do not add per-collection client allows here. Storage rules are separate
// and are not defined in this file.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
