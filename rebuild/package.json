{
  "name": "shiekh-directory-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/functions.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "build": "vite build && npm run build:functions",
    "build:functions": "esbuild server/functions.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/functions.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seedEmulator.ts",
    "seed:users": "tsx server/seedUsers.ts",
    "deploy": "firebase deploy --project shiekh-directory-v2"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "express": "^4.21.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.6.0",
    "libphonenumber-js": "^1.11.11",
    "lucide-react": "^0.454.0",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.8.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "esbuild": "^0.24.0",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
